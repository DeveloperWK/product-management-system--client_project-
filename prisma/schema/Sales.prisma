enum discountAndTaxType {
  PERCENTAGE
  CASH
}

model Sales {
  id             String @id @default(cuid())
  customerId     String
  purchaseId     String
  variantValueId String
  exchangeCal    Float?
  quantity       Float

  // Existing discount fields
  discountType discountAndTaxType?
  discount     Float?

  // Pricing
  price      Float?
  unitPrice  Float?
  salesPrice Float
  taxType    discountAndTaxType?
  tax        Float?

  // 🆕 Coupon fields
  couponId       String? // reference to Coupon if applied
  coupon         Coupon? @relation(fields: [couponId], references: [id])
  discountAmount Float? // actual discount from coupon
  finalAmount    Float? // after applying coupon + tax etc.

  // Relations

  variant  AttributeValue @relation("SalesVariant", fields: [variantValueId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  purchase Purchase       @relation("SalesPurchase", fields: [purchaseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([couponId])
}

model SalesDuePayment {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  createdAt  DateTime @default(now())
}

model PaymentAndDue {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Float
  due        Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId])
}
