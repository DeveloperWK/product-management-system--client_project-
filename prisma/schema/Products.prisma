// ===========================================
// Store & Warehouse
// ===========================================
model Store {
  id        String     @id @default(cuid())
  name      String     @unique
  products  Product[]
  purchases Purchase[]
  createdAt DateTime   @default(now()) // Fixed typo: reatedAt -> createdAt
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String     @unique
  products  Product[]
  purchases Purchase[]
  createdAt DateTime   @default(now())
}

// ===========================================
// Brand, Category, SubCategory, SubSubCategory
// ===========================================
model Brand {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  subCategories SubCategory[]
  products      Product[] // pluralized from product
  createdAt     DateTime      @default(now())
}

model SubCategory {
  id               String           @id @default(cuid())
  name             String
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  subSubCategories SubSubCategory[]
  products         Product[]
  createdAt        DateTime         @default(now())
}

model SubSubCategory {
  id            String      @id @default(cuid())
  name          String
  subCategoryId String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])
  products      Product[]
  createdAt     DateTime    @default(now())
}

// ===========================================
// Attributes & Attribute Values
// ===========================================
model Attribute {
  id        String           @id @default(cuid())
  name      String           @unique
  values    AttributeValue[]
  createdAt DateTime         @default(now())
}

model AttributeValue {
  id          String    @id @default(cuid())
  value       String
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])

  // Relations
  sales     Sales[]    @relation("SalesVariant")
  products  Product[]  @relation("ProductAttributes")
  purchases Purchase[] @relation("PurchaseAttributes")

  createdAt DateTime @default(now())

  @@index([attributeId])
  @@index([value])
}

// ===========================================
// Product & Related Models
// ===========================================
model Product {
  id               String    @id @default(cuid())
  name             String
  slug             String?   @unique
  sku              String?   @unique
  itemCode         String?   @unique
  quantityAlert    Int?
  manufacturedDate DateTime?
  expiryDate       DateTime?
  description      String?

  // Relations
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  subSubCategoryId String?
  subSubCategory   SubSubCategory? @relation(fields: [subSubCategoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  attributes AttributeValue[]    @relation("ProductAttributes")
  purchases  Purchase[]
  images     ProductImage[]
  coupons    CouponsOnProducts[]

  // Meta
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([warehouseId])
  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  url       String
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
}
