model Customer {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String?
  email        String        @unique
  password     String
  phone        String?
  address      String?
  city         String?
  zip          String?
  country      String?       @default("BD")
  refreshToken RefreshToken?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Add Order orders      Order[]
}
