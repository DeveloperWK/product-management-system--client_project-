model Customer {
  id String @id @default(cuid())

  // Basic Information
  firstName String
  lastName  String?

  // Authentication & Contact
  email    String  @unique
  password String
  phone    String? @unique

  // Address Details
  address String?
  city    String?
  zip     String?
  country String? @default("BD")

  // Relations
  sales         Sales[]
  paymentAndDue PaymentAndDue[]
  duePayments   SalesDuePayment[]
  refreshToken  RefreshToken?

  // Meta
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([firstName, lastName])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}
