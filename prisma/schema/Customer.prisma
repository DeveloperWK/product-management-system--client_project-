model Customer {
  id            String            @id @default(cuid())
  firstName     String
  lastName      String?
  email         String            @unique
  password      String
  phone         String?           @unique
  address       String?
  city          String?
  zip           String?
  sales         Sales[]
  PaymentAndDue PaymentAndDue[]
  duePayment    SalesDuePayment[]
  country       String?           @default("BD")
  refreshToken  RefreshToken?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([email, phone])
}
