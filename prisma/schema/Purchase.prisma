enum StatusType {
  PENDING
  DELIVERED
  CANCELLED
}

model Purchase {
  id               String         @id @default(cuid())
  storeId          String
  store            Store          @relation(fields: [storeId], references: [id])
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  warrantyId       String?
  warranty         Warranty?      @relation(fields: [warrantyId], references: [id])
  due              Float?
  salesPurchase    Sales[]        @relation("SalesPurchase")
  attributeValueId String
  attribute        AttributeValue @relation("PurchaseAttributes", fields: [attributeValueId], references: [id])
  status           StatusType     @default(PENDING)
  amount           Float
  amountKey        String
  quantity         Float
  payment          Float
  commission       Float?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  email     String?    @unique
  phone     String
  purchases Purchase[]
}
model Warranty {
  id       String     @id @default(cuid())
  name     String
  days     Int
  purchase Purchase[]
}
